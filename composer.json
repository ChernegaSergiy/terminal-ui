{
    "name": "chernegasergiy/terminal-ui",
    "description": "A library for creating interactive terminal UI components in PHP.",
    "type": "library",
    "license": "LicenseRef-CSSM-Unlimited-2.0",
    "authors": [
        {
            "name": "Serhii Cherneha",
            "email": "chernegasergiy3@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "ChernegaSergiy\\TerminalUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
